# Copy to .env.local for local use, and add the same values in Vercel > Project > Settings > Environment Variables.

# Public URL of the live site, used by the sitemap, canonical links, and social images.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Google Sheets Webhook delivery (saves queries automatically to your private Google Sheet without a database)
# Deploy your Google Apps Script Web App and paste the URL here:
GOOGLE_SHEETS_WEBHOOK_URL=

# Contact form delivery through Resend (https://resend.com) - Optional
RESEND_API_KEY=
# Optional. Defaults to the email in src/data/profile.ts.
CONTACT_TO=
# Optional. Keep the default until you verify your own domain in Resend.
CONTACT_FROM=QA Portfolio <onboarding@resend.dev>
